# ─── Base de données (Supabase / PostgreSQL) ──────────────────────────────────
#
# DATABASE_URL : connexion utilisée par l'application au runtime.
# DIRECT_URL   : connexion directe, non poolée, utilisée par `prisma migrate`.
#                Sur une base locale les deux valeurs sont identiques.
#
# -- Local, via docker compose (voir docker-compose.yml) ----------------------
DATABASE_URL="postgresql://yogella:yogella@localhost:5432/yogella?schema=public"
DIRECT_URL="postgresql://yogella:yogella@localhost:5432/yogella?schema=public"
#
# -- Local, via la CLI Supabase (`supabase start`) ----------------------------
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
#
# -- Supabase cloud (Project Settings → Database → Connection string) ---------
# Transaction pooler (port 6543) au runtime, connexion directe (5432) pour les
# migrations. `connection_limit=1` est requis derrière pgBouncer.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"

# Secret de signature des sessions JWT. En production : openssl rand -hex 32
JWT_SECRET="change-me"

# Origines autorisées par CORS (séparées par des virgules).
# En production le SPA est servi par le même process : mettre le domaine public.
WEB_ORIGIN="http://localhost:5173"

# Répertoire des vidéos uploadées depuis l'admin.
# En conteneur : monter un volume persistant sur ce chemin.
UPLOAD_DIR="./uploads"

# Répertoire du build du front servi par l'API (vide = API seule, mode dev).
# Défini automatiquement dans l'image Docker.
# WEB_DIST_DIR="/app/web"

# ─── Stripe (facultatif) ──────────────────────────────────────────────────────
# Sans clé, les endpoints de paiement renvoient un 503 explicite.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
