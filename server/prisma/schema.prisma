generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanKey {
  MONTHLY
  ANNUAL
}

enum SubStatus {
  NONE
  TRIALING
  ACTIVE
  CANCELED
}

enum CourseKind {
  COURSE
  ARTICLE
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  subscription Subscription?
  favorites    Favorite[]
  progress     WatchProgress[]
}

model Subscription {
  id                   String     @id @default(cuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 PlanKey?
  status               SubStatus  @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  updatedAt            DateTime   @updatedAt
}

model Universe {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  bg    String
  fg    String
  dest  String
  order Int    @default(0)
}

model Course {
  id           String     @id @default(cuid())
  title        String
  kind         CourseKind @default(COURSE)
  universe     String
  category     String?
  durationMin  Int
  premium      Boolean    @default(false)
  videoUrl     String?
  thumbnailUrl String?
  authorName   String?
  authorRole   String?
  body         String?
  createdAt    DateTime   @default(now())

  programLinks ProgramCourse[]
  favorites    Favorite[]
  progress     WatchProgress[]
}

model Program {
  id          String   @id @default(cuid())
  title       String
  description String?
  isRoutine   Boolean  @default(false)
  createdAt   DateTime @default(now())

  courses ProgramCourse[]
}

model ProgramCourse {
  id        String  @id @default(cuid())
  programId String
  courseId  String
  order     Int     @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
}

model Expert {
  id   String @id @default(cuid())
  name String
  role String
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model WatchProgress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progressPct Float    @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Plan {
  id            String  @id @default(cuid())
  key           PlanKey @unique
  label         String
  priceCents    Int
  active        Boolean @default(true)
  stripePriceId String?
}

model Settings {
  id        String @id @default("singleton")
  trialDays Int    @default(0)
}
